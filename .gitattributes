# Normalize all text files to LF in the repository; working copies stay LF.
* text=auto eol=lf

# Windows scripts traditionally require CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
